# Jeton du bot (Portail développeur Discord > Bot)
DISCORD_TOKEN=

# ID de l'application (Portail développeur Discord > General Information)
CLIENT_ID=

# ID du serveur Discord utilisé pour le développement
GUILD_ID=

# development | production
NODE_ENV=development

# URL du panel, utilisée par la future connexion Discord OAuth
DASHBOARD_PUBLIC_URL=http://127.0.0.1:3000
DASHBOARD_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DASHBOARD_API_HOST=127.0.0.1
DASHBOARD_API_PORT=3001
DASHBOARD_SESSION_HOURS=24
DASHBOARD_TRUST_PROXY=false

# Railway : attacher un volume au service bot/API. Railway fournit automatiquement
# RAILWAY_VOLUME_MOUNT_PATH ; FYXBOT_DATA_DIR permet de choisir un chemin manuellement.
FYXBOT_DATA_DIR=

# Sauvegarde externe chiffrée compatible S3 (Cloudflare R2 recommandé).
# Une fois activée, FyxBot crée une première copie puis renouvelle la sauvegarde
# chaque semaine. La base est chiffrée localement avant tout envoi.
FYXBOT_EXTERNAL_BACKUP_ENABLED=false
FYXBOT_BACKUP_S3_ENDPOINT=
FYXBOT_BACKUP_S3_REGION=auto
FYXBOT_BACKUP_S3_BUCKET=fyxbot-backups
FYXBOT_BACKUP_S3_ACCESS_KEY_ID=
FYXBOT_BACKUP_S3_SECRET_ACCESS_KEY=
FYXBOT_BACKUP_S3_PREFIX=fyxbot/weekly
FYXBOT_BACKUP_S3_FORCE_PATH_STYLE=false
FYXBOT_BACKUP_ENCRYPTION_KEY=
# Clé distincte recommandée pour les sauvegardes de structure Discord locales.
# Si elle est vide, FYXBOT_BACKUP_ENCRYPTION_KEY est utilisée. Les sauvegardes
# locales ne sont jamais écrites en clair.
FYXBOT_LOCAL_BACKUP_ENCRYPTION_KEY=
FYXBOT_BACKUP_INTERVAL_DAYS=7
FYXBOT_BACKUP_RETENTION=8

# Transition : les anciennes variables NEXORA_* restent reconnues par le code.
# Ne recopiez pas les secrets uniquement pour renommer la marque.

# Développement local uniquement. Ne jamais activer en production.
ALLOW_UNAUTHENTICATED_LOCAL=false

# À renseigner avant d'activer la connexion Discord sur le panel public
DISCORD_CLIENT_SECRET=

# En production, le callback passe par le domaine du panel afin que la session
# reste compatible avec les protections de cookies des navigateurs :
# En local, Discord accepte http://127.0.0.1:3001/api/auth/callback.
# En production : https://VOTRE-API.up.railway.app/api/auth/callback
DISCORD_OAUTH_CALLBACK=

# Variables du service panel : le navigateur utilise /api sur le même domaine,
# puis le panel transmet les requêtes au service bot/API.
VITE_FYXBOT_API_URL=/api
FYXBOT_API_ORIGIN=http://127.0.0.1:3001

# Future offre payante Discord. Liste séparée par des virgules des identifiants
# de produits (SKU) créés dans le portail Discord. L’accès Fondateur des 100
# premiers utilisateurs fonctionne sans SKU, sans carte et sans paiement.
# Cette variable n’est pas un secret et doit rester vide avant la création des SKU.
FYXBOT_PREMIUM_SKU_IDS=1542203583200624771

# Notifications sociales automatiques. YouTube fonctionne sans clé avec l’ID
# public de la chaîne. Twitch exige une application créée sur dev.twitch.tv.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Intervalle de contrôle, 5 minutes par défaut et 1 minute au minimum.
FYXBOT_SOCIAL_INTERVAL_MS=300000

# Permissions OAuth2 du bot (générées pour les fonctions FyxBot)
# 564049753533558 (inclut la permission Créer des sondages)
# Lien public facultatif vers le serveur Discord d’assistance FyxBot.
FYXBOT_SUPPORT_URL=https://discord.gg/votre-invitation
